# IoT Telemetry Dashboard Backend Environment Configuration

# Application Settings
DEBUG=False
APP_NAME="IoT Telemetry Dashboard"
APP_VERSION="0.1.0"

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=False

# CORS Settings (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=iot_dashboard

# InfluxDB Settings
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=iot-dashboard
INFLUXDB_BUCKET=telemetry

# MQTT Broker Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PATTERN=iot/+/+/+/+/telemetry/v1

# Authentication Settings
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Telemetry Settings
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_BATCH_SIZE=1000
TELEMETRY_FLUSH_INTERVAL_SECONDS=5

# Real-time Streaming Settings
SSE_PING_INTERVAL=30
MAX_SSE_CONNECTIONS=100